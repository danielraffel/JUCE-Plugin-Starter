{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Style Designer",
  "version": "0.1.0",
  "identifier": "com.juce-plugin-starter.style-designer",
  "build": {
    "frontendDist": "../../Tools"
  },
  "app": {
    "windows": [
      {
        "title": "AI Style Designer",
        "url": "theme-designer.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
